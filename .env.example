# VITE_GEMINI_API_KEY: Required for Gemini AI API calls on frontend.
# Vite requires VITE_ prefix to expose variables to client-side code (import.meta.env.VITE_GEMINI_API_KEY).
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# VITE_APP_URL: The public URL where this web app is hosted.
VITE_APP_URL="https://mobile-banking-ui.onrender.com"
